# Nunca subas este archivo con una clave real.
# Configuración compatible con la HDT4:
GROQ_API_KEY=gsk-tu-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# HDT4 RAG: PostgreSQL + pgvector
POSTGRES_USER=parachute
POSTGRES_PASSWORD=postgres-local-2026
POSTGRES_DB=parachute_faqs
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Alternativa si usarás directamente OpenAI:
# OPENAI_API_KEY=sk-tu-api-key

# HDT7: el cliente solo usa A2A_URL; el servidor A2A usa MCP_URL.
MCP_URL=http://127.0.0.1:8001/mcp
A2A_URL=http://127.0.0.1:8000
A2A_PUBLIC_URL=http://127.0.0.1:8000/
# Opcional: ruta de persistencia para el proceso MCP.
# APPOINTMENTS_PATH=data/citas.json
